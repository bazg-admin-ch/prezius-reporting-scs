<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bazg.prezius</groupId>
        <artifactId>prezius-reporting-scs</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>prezius-reporting-service</artifactId>
    <name>${project.artifactId}</name>
    <packaging>jar</packaging>

    <properties>
        <prezius-common.version>4.11.0</prezius-common.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <org.mapstruct.version>1.6.3</org.mapstruct.version>
        <easy-random-core.version>4.3.0</easy-random-core.version>
        <java.version>25</java.version>
        <prezius-billing-created-event.version>1.6.0</prezius-billing-created-event.version>
        <togglz-testing.version>4.6.4</togglz-testing.version>
        <prezius-invoicing-not-required-event.version>1.0.1</prezius-invoicing-not-required-event.version>
        <com.squareup.okhttp3.version>5.5.1</com.squareup.okhttp3.version>
        <reactor-core-version>3.8.8</reactor-core-version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-open-api-publisher-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-db-schema-publisher-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-featureflag-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-reaction-observer-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-postgresql-aws-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-config-aws-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-tls-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.admin.bazg.prezius</groupId>
            <artifactId>prezius-reporting-ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bazg.prezius</groupId>
            <artifactId>prezius-reporting-scs-ui-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bazg.prezius</groupId>
            <artifactId>prezius-common-core</artifactId>
            <version>${prezius-common.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bazg.prezius</groupId>
            <artifactId>prezius-common-order-client</artifactId>
            <version>${prezius-common.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-security-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-monitoring-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-swagger-starter</artifactId>
        </dependency>
        <dependency>
            <artifactId>qd-service-lib</artifactId>
            <groupId>ch.admin.bazg.quadrel</groupId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- messaging -->
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-messaging-infrastructure-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-messaging-outbox</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-messaging-idempotence</artifactId>
        </dependency>

        <!-- message types -->
        <dependency>
            <groupId>ch.admin.bazg.messagetype.prezius</groupId>
            <artifactId>prezius-billing-created-event</artifactId>
            <version>${prezius-billing-created-event.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bazg.messagetype.prezius</groupId>
            <artifactId>prezius-order-deleted-event</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bazg.messagetype.datahub</groupId>
            <artifactId>datahub-businesspartner-created-event</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bazg.messagetype.datahub</groupId>
            <artifactId>datahub-businesspartner-updated-event</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bazg.messagetype.prezius</groupId>
            <artifactId>prezius-invoicing-not-required-event</artifactId>
            <version>${prezius-invoicing-not-required-event.version}</version>
        </dependency>

        <!-- persistence-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- mapping -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${org.mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${org.mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- architecture test dependencies -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>${reactor-core-version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-security-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-messaging-infrastructure-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>au.com.dius.pact.provider</groupId>
            <artifactId>junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>au.com.dius.pact.consumer</groupId>
            <artifactId>junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jeasy</groupId>
            <artifactId>easy-random-core</artifactId>
            <version>${easy-random-core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${com.squareup.okhttp3.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.togglz</groupId>
            <artifactId>togglz-testing</artifactId>
            <version>${togglz-testing.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.togglz</groupId>
            <artifactId>togglz-junit</artifactId>
            <version>${togglz-testing.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <org.apache.avro.SERIALIZABLE_PACKAGES>ch.admin</org.apache.avro.SERIALIZABLE_PACKAGES>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>ch.admin.bit.jeap</groupId>
                            <artifactId>jeap-messaging-contract-annotations</artifactId>
                            <version>${jeap-messaging.version}</version>
                        </path>
                        <path>
                            <groupId>org.hibernate.orm</groupId>
                            <artifactId>hibernate-jpamodelgen</artifactId>
                            <version>${hibernate.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>truststore-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-truststores</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <certificateRepositoryUrl>https://github.com/BAZG-System/dazit-certificates</certificateRepositoryUrl>
                    <includes>
                        <include>cacerts/internal</include>
                        <include>cacerts/public</include>
                        <include>cacerts/aws</include>
                        <include>infrastructure/kafka</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>au.com.dius.pact.provider</groupId>
                <artifactId>maven</artifactId>
                <executions>
                    <execution>
                        <phase>test</phase>
                        <goals>
                            <goal>publish</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.2</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- set the timeout for the framework to terminate stale tests -->
                    <timeoutConstant>1000</timeoutConstant>
                    <verbose>true</verbose>
                    <!-- set the package where your targeted clases are located -->
                    <targetClasses>
                        <param>ch.admin.bazg.prezius.reporting.*</param>
                    </targetClasses>
                    <!-- Exclude all Pact tests -->
                    <excludedClasses>
                        <param>ch.admin.bazg.prezius.reporting.service.bp.dtos.AddressDtoV4</param>
                        <param>ch.admin.bazg.prezius.reporting.service.bp.dtos.BusinessPartnerCompanyIdDtoV4</param>
                        <param>ch.admin.bazg.prezius.reporting.service.bp.dtos.PostOfficeBoxDtoV4</param>
                        <param>ch.admin.bazg.prezius.reporting.service.bp.MockBusinessPartnerService</param>
                        <param>ch.admin.bazg.prezius.reporting.adapter.in.frontendconfig.configuration.GetConfigurationUiRestController</param>
                        <param>ch.admin.bazg.prezius.reporting.adapter.in.frontendconfig.configuration.ConfigurationDTO</param>
                    </excludedClasses>
                    <!-- set the package where your tests are located -->
                    <targetTests>
                        <param>ch.admin.bazg.prezius.reporting.*</param>
                    </targetTests>
                    <!-- Exclude all Pact tests -->
                    <excludedTestClasses>
                        <param>ch.admin.bazg.prezius.reporting.cdc.BillingApiPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.BusinessPartnerCompanyBpByIdPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.BusinessPartnerPersonBpByIdPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.BusinessPartnerGetAllWithRolePactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.HallmarkingApiPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.OrderApiGetCustomsOfficesPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.OrderApiGetOrderPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.PactConsumerBaseTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.ReportingPactProviderTest</param>
                        <param>ch.admin.bazg.prezius.reporting.cdc.ValidationApiPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.adapter.out.rest.prezius.billing.GetAnalysisBillingApiPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.adapter.out.rest.prezius.hallmarking.GetHallmarkingsByHallmarkingOrderPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.adapter.out.rest.prezius.order.OrderApiGetAnalysisOrderPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.adapter.out.rest.prezius.validation.ValidationApiGetComplaintsPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.adapter.out.rest.prezius.billing.GetHallmarkingBillingApiPactConsumerTest</param>
                        <param>ch.admin.bazg.prezius.reporting.adapter.out.rest.prezius.order.OrderApiGetHallmarkingOrderPactConsumerTest</param>
                    </excludedTestClasses>
                    <features>
                        <!-- enable running multiple threads -->
                        <feature>+auto_threads</feature>
                        <!-- Set the limit of mutations in a single class.
                             Be careful with increasing this number. This will extend the executiontime a lot.
                            -->
                        <feature>+CLASSLIMIT(limit[8])</feature>
                    </features>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>
        </plugins>
    </build>

    <!-- generates a readable html report of the mutation results -->
    <reporting>
        <plugins>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.2</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>
</project>
