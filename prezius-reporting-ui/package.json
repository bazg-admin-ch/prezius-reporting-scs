{
  "name": "prezius-reporting-ui",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "scripts": {
    "check-licenses": "jeap-frontend-license-checker",
    "prebuild": "npm run check-licenses && npm run generate-license-file",
    "prebuild-prod": "npm run check-licenses && npm run generate-license-file",
    "generate-license-file": "jeap-frontend-license-checker notices && jeap-frontend-license-checker notices --out src/assets/THIRD-PARTY-LICENSES.md --texts folder --texts-dir third-party-licenses",
    "generate": "openapi-generator-cli generate -i ../prezius-reporting-scs-ui-api/src/main/resources/prezius-reporting-scs-ui-api.yaml -g typescript-angular -o src/app/modules/openapi --additional-properties fileNaming=kebab-case,withInterfaces=true,ngVersion=20.0.0 --generate-alias-as-model",
    "ng": "ng",
    "start": "ng serve --port 4206",
    "build": "ng build",
    "build-prod": "ng build --configuration=production --source-map=true",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "pretty:ts": "pretty-quick --parser mdx",
    "pretty:scss": "stylelint \"src/**/*.scss\" --fix",
    "pretty": "npm run pretty:ts && npm run pretty:scss"
  },
  "jest": {
    "testResultsProcessor": "jest-sonar-reporter"
  },
  "jestSonar": {
    "reportPath": "./coverage/sonarQube",
    "reportFile": "sqr.xml",
    "indent": 4,
    "sonar56x": true
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@angular/animations": "20.3.21",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.21",
    "@angular/compiler": "20.3.21",
    "@angular/core": "20.3.21",
    "@angular/forms": "20.3.21",
    "@angular/localize": "20.3.21",
    "@angular/platform-browser": "20.3.21",
    "@angular/platform-browser-dynamic": "20.3.21",
    "@angular/router": "20.3.21",
    "@ngrx/effects": "20.1.0",
    "@ngrx/store": "20.1.0",
    "@ngrx/store-devtools": "20.1.0",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@quadrel-enterprise-ui/alarm": "^20.0.1",
    "@quadrel-enterprise-ui/auth": "^20.1.3",
    "@quadrel-enterprise-ui/browser-check": "^20.0.1",
    "@quadrel-enterprise-ui/framework": "20.15.1",
    "@quadrel-enterprise-ui/language": "^20.0.1",
    "@quadrel-enterprise-ui/persistence": "^20.0.2",
    "rxjs": "^7.8.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "20.0.0",
    "@angular-eslint/builder": "^20.4.0",
    "@angular-eslint/eslint-plugin": "20.4.0",
    "@angular-eslint/eslint-plugin-template": "20.4.0",
    "@angular-eslint/schematics": "20.4.0",
    "@angular-eslint/template-parser": "20.4.0",
    "@angular/build": "^20.3.21",
    "@angular/cli": "20.3.21",
    "@angular/compiler-cli": "20.3.21",
    "@jeap/jeap-frontend-license-checker": "1.0.2",
    "@openapitools/openapi-generator-cli": "^2.21.0",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.0",
    "jest-sonar-reporter": "2.0.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.2.2",
    "stylelint": "^16.20.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-order": "^6.0.4",
    "ts-jest": "29.2.4",
    "ts-node": "10.9.2",
    "typescript": "^5.8.3"
  },
  "husky": {
    "hooks": {
      "commit-msg": "node scripts/hook.commit-rules",
      "pre-commit": "lint-staged -v"
    }
  },
  "lint-staged": {
    "*.{ts,html}": [
      "pretty-quick"
    ],
    "*.scss": [
      "npm run pretty:scss"
    ]
  }
}
